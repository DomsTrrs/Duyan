
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Duyan</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Duyan.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-container">

        <!-- LEFT SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-header">
                <h4>DUYAN</h4>
                <small>
                    @if (User.IsInRole("PlatformAdmin"))
                    {
                        @:Platform Administration
                    }
                    else if (User.IsInRole("HotelAdmin"))
                    {
                        @:Hotel Administration
                    }
                    else if (User.IsInRole("HotelStaff"))
                    {
                        @:Hotel Staff
                    }
                </small>
            </div>

            <!-- PLATFORM ADMIN NAVIGATION -->
            @if (User.IsInRole("PlatformAdmin"))
            {
                <nav class="sidebar-nav">

                    <a asp-controller="PlatformAdmin"
                       asp-action="Dashboard"
                       class="nav-link">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>

                    <a asp-controller="PlatformAdmin"
                       asp-action="RegistrationRequests"
                       class="nav-link">
                        <i class="bi bi-inbox"></i>
                        Registration Requests
                    </a>

                    <a asp-controller="PlatformAdmin"
                       asp-action="HotelManagement"
                       class="nav-link">
                        <i class="bi bi-building"></i>
                        Hotel Management
                    </a>

                   
                    

                    <a asp-controller="PlatformAdmin"
                       asp-action="ActivityLogs"
                       class="nav-link">
                        <i class="bi bi-clock-history"></i>
                        Activity Logs
                    </a>

                    

                </nav>
            }

            <!-- HOTEL ADMIN NAVIGATION -->
            else if (User.IsInRole("HotelAdmin"))
            {
            <nav class="sidebar-nav">
                <a asp-controller="HotelAdmin" asp-action="Dashboard" class="nav-link">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>
            </nav>
            }

            <!-- HOTEL STAFF NAVIGATION -->
            else if (User.IsInRole("HotelStaff"))
            {
            <nav class="sidebar-nav">
                <a asp-controller="HotelStaff" asp-action="Dashboard" class="nav-link">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>
            </nav>
            }

        </aside>


        <!-- MAIN CONTENT -->
        <div class="main-wrapper">

            <!-- TOP NAVBAR -->
            <header class="top-navbar">

                <div class="ms-auto d-flex align-items-center gap-3">

                    <span class="text-muted small">
                        <i class="bi bi-person"></i>
                        @User.Identity?.Name
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm">
                            Log out
                        </button>
                    </form>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>

    </div>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
