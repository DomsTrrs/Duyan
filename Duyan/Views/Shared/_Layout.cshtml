@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Duyan</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Duyan.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-container">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-header">
                <h4>DUYAN</h4>

                <small>
                    @if (User.IsInRole("PlatformAdmin"))
                    {
                        @:Platform Administration
                    }
                    else if (User.IsInRole("HotelManager"))
                    {
                        @:Hotel Management
                    }
                    else if (User.IsInRole("HotelStaff"))
                    {
                        @:Hotel Staff
                    }
                </small>
            </div>

            <nav class="sidebar-nav">

                <!-- PLATFORM ADMIN -->
                @if (User.IsInRole("PlatformAdmin"))
                {
                    <a asp-controller="PlatformAdmin"
                       asp-action="Dashboard"
                       class="nav-link @(currentController == "PlatformAdmin" && currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>

                    <a asp-controller="PlatformAdmin"
                       asp-action="RegistrationRequests"
                       class="nav-link @(currentController == "PlatformAdmin" && currentAction == "RegistrationRequests" ? "active" : "")">
                        <i class="bi bi-inbox"></i>
                        Registration Requests
                    </a>

                    <a asp-controller="PlatformAdmin"
                       asp-action="HotelManagement"
                       class="nav-link @(currentController == "PlatformAdmin" && currentAction == "HotelManagement" ? "active" : "")">
                        <i class="bi bi-building"></i>
                        Hotel Management
                    </a>

                    

                    <a asp-controller="PlatformAdmin"
                       asp-action="ActivityLogs"
                       class="nav-link @(currentController == "PlatformAdmin" && currentAction == "ActivityLogs" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        Activity Logs
                    </a>
                }

                <!-- HOTEL MANAGER -->
                else if (User.IsInRole("HotelManager"))
                {
                <a asp-controller="HotelManager"
                   asp-action="Hotel_Manager"
                   class="nav-link @(currentController == "HotelManager" && currentAction == "Hotel_Manager" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>
                }

                <!-- HOTEL STAFF -->
                else if (User.IsInRole("HotelStaff"))
                {
                <a asp-controller="HotelStaff"
                   asp-action="Hotel_Staff"
                   class="nav-link @(currentController == "HotelStaff" && currentAction == "Hotel_Staff" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>
                }

            </nav>

        </aside>


        <!-- MAIN AREA -->
        <div class="main-wrapper">

            <!-- TOP NAVBAR -->
            <header class="top-navbar">

                <div class="ms-auto d-flex align-items-center gap-3">

                    <span class="text-muted small">
                        <i class="bi bi-person"></i>
                        @User.Identity?.Name
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm">
                            Log out
                        </button>

                    </form>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>

    </div>


    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
