@model Duyan.Models.ViewModels.LoginViewModel

<h1>Sign in</h1>
<p class="lead-text">Use your hotel account to continue.</p>

<form asp-controller="Account" asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control"
               placeholder="you@hotel.com" autocomplete="username" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" type="password" class="form-control"
               placeholder="Enter your password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-signin">Sign in</button>
    </div>

</form>