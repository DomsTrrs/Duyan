@{
    ViewData["Title"] = "Activity Logs";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/PlatformAdmin.css" asp-append-version="true" />

<h1 class="h3 page-title mb-1">Activity Logs</h1>
<p class="text-muted mb-4">Administrative actions and account changes across the platform.</p>

@* ---------- Summary cards (empty) ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-4">
        <div class="card stat-card stat-card-accent border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-journal-text"></i></div>
                <div class="text-muted small">Total entries</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-calendar-day"></i></div>
                <div class="text-muted small">Today</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-calendar-week"></i></div>
                <div class="text-muted small">This week</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
</div>

@* ---------- Log table (empty) ---------- *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><strong>Recent activity</strong></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>When</th><th>Who</th><th>Action</th><th>Details</th></tr>
            </thead>
            <tbody>
                <tr><td colspan="4" class="text-center text-muted py-5">No data yet</td></tr>
            </tbody>
        </table>
    </div>
</div>