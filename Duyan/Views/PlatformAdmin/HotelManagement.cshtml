@{
    ViewData["Title"] = "Hotel Management";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/PlatformAdmin.css" asp-append-version="true" />

@* ---------- Title + Register Hotel button ---------- *@
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 page-title mb-1">Hotel Management</h1>
        <p class="text-muted mb-0">Register hotels and manage their accounts.</p>
    </div>
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#registerHotelModal">
        <i class="bi bi-plus-lg me-1"></i>Register Hotel
    </button>
</div>

@* ---------- Summary cards (empty) ---------- *@
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card stat-card stat-card-accent border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-building"></i></div>
                <div class="text-muted small">Registered</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
                <div class="text-muted small">Active</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-slash-circle"></i></div>
                <div class="text-muted small">Suspended / Deactivated</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
</div>

@* ---------- Registered Hotels table (empty) ---------- *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><strong>Registered Hotels</strong></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hotel</th>
                    <th>Address</th>
                    <th>Contact</th>
                    <th>Hotel administrator</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr><td colspan="6" class="text-center text-muted py-5">No data yet</td></tr>
            </tbody>
        </table>
    </div>
</div>

@* ---------- Pop-up (partial view) ---------- *@
<partial name="_RegisterHotelModal" />

@section Scripts {
    <script>
        // Moves the pop-up to <body> so it always appears above the page and the dark overlay
        document.body.appendChild(document.getElementById('registerHotelModal'));
    </script>
}