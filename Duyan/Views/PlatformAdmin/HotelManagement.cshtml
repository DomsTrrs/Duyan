@{
    ViewData["Title"] = "Hotel Management";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/PlatformAdmin.css" asp-append-version="true" />

<h1 class="h3 page-title mb-1">Hotel Management</h1>
<p class="text-muted mb-4">Review registration requests and manage hotel accounts.</p>

@* ---------- Summary cards (empty) ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card stat-card-accent border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-building"></i></div>
                <div class="text-muted small">Registered hotels</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
                <div class="text-muted small">Active hotels</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                <div class="text-muted small">Pending applications</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-slash-circle"></i></div>
                <div class="text-muted small">Suspended / deactivated</div>
                <div class="stat-value">&ndash;</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* ---------- Registration requests (empty) ---------- *@
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><strong>Registration requests</strong></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Hotel</th><th>Applicant</th><th>Submitted</th></tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="3" class="text-center text-muted py-5">No data yet</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ---------- Registered hotels (empty) ---------- *@
    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white"><strong>Registered hotels</strong></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Hotel</th><th>Hotel administrator</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="3" class="text-center text-muted py-5">No data yet</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>