<div class="modal fade" id="registerHotelModal" tabindex="-1"
     aria-labelledby="registerHotelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="registerHotelModalLabel">Register Hotel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @* TODO (next step): add asp-controller="PlatformAdmin" asp-action="RegisterHotel" and change
               the Register button below to type="submit" once the RegisterHotel action exists. *@
            <form id="registerHotelForm" method="post">
                <div class="modal-body">

                    <h6 class="fw-bold mb-3">Hotel details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label for="hotelName" class="form-label">Hotel name</label>
                            <input type="text" id="hotelName" name="Hotel_name" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label for="hotelAddress" class="form-label">Address</label>
                            <input type="text" id="hotelAddress" name="Address" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="hotelContact" class="form-label">Contact number</label>
                            <input type="text" id="hotelContact" name="Contact_number" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="hotelEmail" class="form-label">Hotel email</label>
                            <input type="email" id="hotelEmail" name="Contact_email" class="form-control" required />
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3">Hotel administrator account</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="adminName" class="form-label">Full name</label>
                            <input type="text" id="adminName" name="Admin_full_name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="adminEmail" class="form-label">Email</label>
                            <input type="email" id="adminEmail" name="Admin_email" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="adminPassword" class="form-label">Password</label>
                            <input type="password" id="adminPassword" name="Admin_password"
                                   class="form-control" autocomplete="new-password" required />
                        </div>
                        <div class="col-md-6">
                            <label for="adminConfirm" class="form-label">Confirm password</label>
                            <input type="password" id="adminConfirm" name="Admin_confirm_password"
                                   class="form-control" autocomplete="new-password" required />
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary">Register hotel</button>
                </div>
            </form>

        </div>
    </div>
</div>