@{
    ViewData["Title"] = "Dashboard";
    Layout = "_HotelAdminLayout";
}

<h1 class="h3 page-title mb-1">Hotel Dashboard</h1>
<p class="text-muted mb-4">Overview of your hotel's operations and performance.</p>

@* ---------- Summary cards ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Total rooms</div>
                <div class="stat-value">45</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Available rooms</div>
                <div class="stat-value">28</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Occupied rooms</div>
                <div class="stat-value">12</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Today's arrivals</div>
                <div class="stat-value">8</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Today's departures</div>
                <div class="stat-value">5</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Occupancy rate</div>
                <div class="stat-value">38%</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">

    @* ---------- Today's arrivals ---------- *@
    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Today's arrivals</strong>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-in</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Juan Dela Cruz</td>
                            <td>101</td>
                            <td>2:00 PM</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                        </tr>
                        <tr>
                            <td>Maria Santos</td>
                            <td>205</td>
                            <td>3:00 PM</td>
                            <td><span class="badge bg-success">Checked-in</span></td>
                        </tr>
                        <tr>
                            <td>Pedro Reyes</td>
                            <td>302</td>
                            <td>4:00 PM</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ---------- Revenue summary ---------- *@
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Revenue summary</strong>
            </div>

            <div class="card-body">
                <div class="mb-4">
                    <div class="text-muted small">Today's revenue</div>
                    <div class="stat-value">₱18,500.00</div>
                </div>

                <hr />

                <div class="mb-4">
                    <div class="text-muted small">This week's revenue</div>
                    <div class="h4 mb-0">₱95,200.00</div>
                </div>

                <hr />

                <div>
                    <div class="text-muted small">This month's revenue</div>
                    <div class="h4 mb-0">₱385,000.00</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    @* ---------- Today's departures ---------- *@
    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Today's departures</strong>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-out</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Angela Garcia</td>
                            <td>103</td>
                            <td>11:00 AM</td>
                            <td><span class="badge bg-success">Paid</span></td>
                        </tr>
                        <tr>
                            <td>Mark Villanueva</td>
                            <td>204</td>
                            <td>12:00 PM</td>
                            <td><span class="badge bg-warning text-dark">Partial</span></td>
                        </tr>
                        <tr>
                            <td>Sofia Martinez</td>
                            <td>305</td>
                            <td>1:00 PM</td>
                            <td><span class="badge bg-success">Paid</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ---------- Recent activity ---------- *@
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Recent activity</strong>
            </div>

            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <div><strong>Hotel Staff</strong> - Registered a new guest</div>
                    <div class="small text-muted">Juan Dela Cruz</div>
                    <div class="small text-muted">Nov 25, 2026 9:15 AM</div>
                </li>

                <li class="list-group-item">
                    <div><strong>Hotel Staff</strong> - Recorded a payment</div>
                    <div class="small text-muted">Reservation #RES-0021</div>
                    <div class="small text-muted">Nov 25, 2026 10:30 AM</div>
                </li>

                <li class="list-group-item">
                    <div><strong>Hotel Admin</strong> - Updated room information</div>
                    <div class="small text-muted">Room 305</div>
                    <div class="small text-muted">Nov 24, 2026 3:45 PM</div>
                </li>
            </ul>
        </div>
    </div>
</div>
s